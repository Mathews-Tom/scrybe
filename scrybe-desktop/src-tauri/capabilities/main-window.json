{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Everything the Sessions window may call. Scoped to that one window by label: a window this application has not declared inherits nothing from this file. No filesystem, shell, HTTP, process, or path permission appears here, and none is required \u2014 every path the application touches is resolved in Rust beneath the configured storage root.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-list-sessions",
    "allow-search-sessions",
    "allow-cancel-query",
    "allow-get-session",
    "allow-read-notes",
    "allow-read-transcript-page",
    "allow-repair-session",
    "allow-regenerate-notes",
    "allow-reveal-session",
    "allow-copy-notes",
    "allow-copy-transcript",
    "allow-settings-summary",
    "allow-recording-status",
    "allow-settings-form",
    "allow-apply-settings",
    "allow-diagnostics-report",
    "allow-apply-recovery",
    "allow-readiness-report",
    "allow-model-offer",
    "allow-install-model",
    "allow-cancel-model-install",
    "allow-open-system-settings",
    "allow-open-advanced-configuration"
  ]
}
